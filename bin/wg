#!/usr/bin/env bash
# wargame CLI — tracks: k8s linux docker helm supabase
set -euo pipefail
ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
STATE=${WG_STATE:-$HOME/.k8s-wargame}; mkdir -p "$STATE"
export KUBECONFIG=${KUBECONFIG:-$HOME/.kube/config}
export WG_ROOT=$ROOT

usage() { cat <<U
wg — break/fix wargame          tracks: $(tracks | tr '\n' ' ')

  wg track NAME       switch track (default k8s)
  wg start            bring up the environment of the current track
  wg stop             tear it down
  wg shell            enter the broken machine (tracks that have one)
  wg list             levels of the current track + status
  wg level N          load level N (something is now broken)
  wg brief            briefing again
  wg check            am i done?
  wg hint             next hint (3 per level, counted)
  wg spoil            solution (marks level spoiled)
  wg reset / wg next
  wg progress         scoreboard (all tracks)
U
}
tracks() { ls -d "$ROOT"/levels/*/ | xargs -n1 basename; }
TRACK=${WG_TRACK:-$(cat "$STATE/track" 2>/dev/null || echo k8s)}
TDIR="$ROOT/levels/$TRACK"; [ -f "$TDIR/track.sh" ] || { echo "unknown track $TRACK" >&2; exit 1; }
source "$TDIR/track.sh"
levels() { ls -d "$TDIR"/[0-9]* | xargs -n1 basename | sort; }
level_dir() { ls -d "$TDIR"/$(printf '%02d' "$1")-* 2>/dev/null | head -1; }
cur() { cat "$STATE/$TRACK.current" 2>/dev/null || { echo "no level loaded — wg level 1" >&2; exit 1; }; }
need_env() { track_ready || { echo "$TRACK environment not ready — wg start" >&2; exit 1; }; }
key() { echo "$TRACK/$1"; }

cmd_track() { [ -d "$ROOT/levels/$1" ] || { echo "no track $1"; exit 1; }; echo "$1" > "$STATE/track"; echo "track: $1"; }
cmd_start() { track_start; echo "ready. → wg level 1"; }
cmd_stop()  { track_stop; }
cmd_shell() { need_env; type track_shell >/dev/null 2>&1 || { echo "track $TRACK has no shell — use your normal terminal"; exit 1; }; track_shell; }
cmd_level() {
  need_env; local d; d=$(level_dir "$1") || true; [ -n "$d" ] || { echo "no level $1 in $TRACK"; exit 1; }
  local prev; prev=$(cat "$STATE/$TRACK.current" 2>/dev/null || true)
  [ -n "$prev" ] && [ -f "$TDIR/$prev/clean.sh" ] && (cd "$TDIR/$prev" && bash clean.sh >/dev/null 2>&1 || true)
  local l; l=$(basename "$d"); echo "loading $TRACK/${l}…"; track_wipe
  (cd "$d" && bash break.sh)
  echo "$l" > "$STATE/$TRACK.current"; date +%s > "$STATE/$TRACK.$l.start"; : > "$STATE/$TRACK.$l.hints"
  echo; cat "$d/README.md"; echo; echo "→ fix it, then: wg check   (stuck? wg hint)"
}
cmd_brief() { cat "$TDIR/$(cur)/README.md"; }
cmd_check() {
  need_env; local l; l=$(cur); echo "checking $TRACK/${l}…"
  if (cd "$TDIR/$l" && bash check.sh); then
    local s h sp start; start=$(cat "$STATE/$TRACK.$l.start"); s=$(( $(date +%s) - start ))
    h=$(wc -l < "$STATE/$TRACK.$l.hints" | tr -d ' '); sp=""; [ -f "$STATE/$TRACK.$l.spoiled" ] && sp=" spoiled"
    grep -v "^$TRACK/$l " "$STATE/progress" 2>/dev/null > "$STATE/progress.tmp" || true
    echo "$TRACK/$l solved ${s}s hints=$h$sp" >> "$STATE/progress.tmp"; mv "$STATE/progress.tmp" "$STATE/progress"
    printf '\n\033[1;32mLEVEL SOLVED\033[0m  %ss, %s hints%s\n→ wg next\n' "$s" "$h" "$sp"
  else printf '\n\033[1;31mnot yet.\033[0m\n'; exit 1; fi
}
cmd_hint() {
  local l; l=$(cur); local n; n=$(( $(wc -l < "$STATE/$TRACK.$l.hints" | tr -d ' ') + 1 ))
  local txt; txt=$(awk -v n="$n" '/^## /{c++} c==n && !/^## /' "$TDIR/$l/hints.md")
  [ -n "$txt" ] || { echo "no more hints. → wg spoil"; exit 0; }
  echo "$n" >> "$STATE/$TRACK.$l.hints"; printf '\033[33mhint %s:\033[0m%s\n' "$n" "$txt"
}
cmd_spoil() { local l; l=$(cur); touch "$STATE/$TRACK.$l.spoiled"; cat "$TDIR/$l/solution.md"; }
cmd_reset() { local l; l=$(cur); cmd_level "$(( 10#${l%%-*} ))"; }
cmd_next()  { local l; l=$(cur); cmd_level "$(( 10#${l%%-*} + 1 ))"; }
cmd_list()  { echo "track: $TRACK"; for l in $(levels); do local st="  "; grep -q "^$TRACK/$l " "$STATE/progress" 2>/dev/null && st="✔ "; [ "$l" = "$(cat "$STATE/$TRACK.current" 2>/dev/null)" ] && st="▶ "; printf '%s%s  %s\n' "$st" "$l" "$(head -1 "$TDIR/$l/README.md" | sed 's/^# //')"; done; }
cmd_progress() { [ -f "$STATE/progress" ] && sort "$STATE/progress" || echo "nothing solved yet"; echo; for t in $(tracks); do printf '%-9s %s / %s\n' "$t" "$(grep -c "^$t/" "$STATE/progress" 2>/dev/null || echo 0)" "$(ls -d "$ROOT"/levels/$t/[0-9]* | wc -l | tr -d ' ')"; done; }

case "${1:-}" in
  start|stop|shell|brief|check|hint|spoil|reset|next|list|progress) "cmd_$1" ;;
  level) cmd_level "${2:?level number}" ;;
  track) cmd_track "${2:?track name}" ;;
  *) usage ;;
esac
